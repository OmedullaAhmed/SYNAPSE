# Copy to ../.env and fill in. Never commit the filled-in file.
DOMAIN=stock.yourcompany.com
DB_PASSWORD=change-me-to-a-long-random-string
STOCKFLOW_API_SECRET=change-me-another-long-random-string
BACKUP_DAYS=30
# optional
# SENTRY_DSN=https://...@sentry.io/...        error tracking for the web app and the API
# ANTHROPIC_API_KEY=...                       AI answers and reading handwriting (both off until an admin turns them on)
# STOCKFLOW_ERP_CHANNEL=sftp                  plus the [erp] section in deploy/secrets.toml
# STOCKFLOW_ALERTS_WEBHOOK=https://...        Teams / Slack / Google Chat
